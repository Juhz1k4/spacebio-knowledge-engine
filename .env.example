# SpaceBio — modelo de configuração local
# Copie para .env e preencha. O .env NUNCA deve ser versionado.

# --- Neo4j ---
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- CORS (origens do frontend) ---
# Deixe VAZIO em desenvolvimento: a API libera qualquer origem da rede local
# via regex (localhost, 127.0.0.1, ::1 e as faixas da RFC 1918), o que evita
# ter de reeditar este arquivo toda vez que o DHCP troca o IP da maquina.
#
# Em producao, liste as origens explicitamente, separadas por virgula. Quando
# listar, inclua `localhost` E `127.0.0.1`: sao origens DISTINTAS para o
# navegador, e um frontend aberto por uma delas leva 403 se so a outra estiver
# declarada. Exemplo:
#     CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
#
# Nao use `*`: a especificacao CORS proibe o wildcard junto com credenciais,
# e o preflight falha no NAVEGADOR mesmo com o servidor respondendo 200.
CORS_ORIGINS=

# --- Embeddings (SPACEBIO-010) ---
# O modelo AQUI precisa ser o MESMO que gerou os vetores gravados no grafo.
# Usar outro produz embeddings incompatíveis com o índice e a busca degrada em
# silêncio: nada falha, os resultados e que ficam ruins.
#
# O multilingual-e5-small substituiu o all-MiniLM-L6-v2 porque perguntas em
# português pontuavam abaixo do limiar por defeito do encoder, não por falta de
# evidência. Mantém 384 dimensões, então o índice não precisou ser recriado.
# É assimétrico: exige os prefixos `passage: ` e `query: `, aplicados em
# embedder.py. Trocar o modelo exige revetorizar os 45.947 chunks.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# --- Chunking (SPACEBIO-009) ---
# 700/140 foi calibrado contra o limite de 256 tokens do MiniLM, onde 1000/200
# truncava 30,9% dos chunks em silêncio. O e5-small aceita 512 tokens e hoje
# trunca 0,7%; a folga foi mantida de propósito.
# Alterar aqui invalida os IDs determinísticos já gravados no grafo.
CHUNK_SIZE=700
CHUNK_OVERLAP=140

# --- Índice vetorial (SPACEBIO-011) ---
VECTOR_INDEX_NAME=chunk_embedding_index
VECTOR_SIMILARITY=cosine

# --- LLM (Dra. Aris) — SPACEBIO-015 ---
GOOGLE_API_KEY=

# Modelo do provedor. ATENÇÃO à quota: o free tier do Gemini permite apenas
# 20 requisições POR DIA por modelo. Modelos "lite" costumam ter limites
# maiores; com billing ativo, a restrição desaparece.
LLM_MODEL=gemini-flash-lite-latest

# 4096 e não menos: os modelos atuais gastam ~950 tokens do orçamento de saída
# com raciocínio interno antes de escrever. Com 1024, a resposta é cortada no
# meio de uma citação.
LLM_MAX_OUTPUT_TOKENS=4096

# Similaridade mínima para a Dra. Aris aceitar responder. Recalibrado para o
# multilingual-e5-small, que comprime a faixa de scores: perguntas do domínio
# pontuam 0,921-0,963 e perguntas fora dele 0,865-0,916. A margem é estreita,
# e o limiar sozinho NÃO separa os dois grupos — ele é a primeira de três
# travas, junto da regra de recusa sem citar (prompts.py) e da verificação de
# citacoes em código (evidence.verify_citations).
#
# O valor do MiniLM era 0.72 e NÃO se transporta: as escalas são diferentes.
EVIDENCE_THRESHOLD=0.92
